(defcfg
  process-unmapped-keys	yes	;;|no| enable processing of keys that are not in defsrc, useful if mapping a few keys in defsrc instead of most of the keys on your keyboard. Without this, the tap-hold-release and tap-hold-press actions will not activate for keys that are not in defsrc. Disabled because some keys may not work correctly if they are intercepted. E.g. rctl/altgr on Windows; see the windows-altgr configuration item above for context.
  log-layer-changes    	yes	;;|no| overhead
)
;; Caps to escape/control configuration for Kanata

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  tab  q    w    e    r    t    u    i    o    p
  caps a    s    d    f    g    h    j    k    l    ;
  lsft z    x    c    v    b    n    m    ,    .    /
)

(defvar
  tap-time 150
  hold-time 200
)

;; Definine two aliases, one for esc/control to other for function key
(defalias
  nav (layer-toggle nav)

  ctl_a (tap-hold $tap-time $hold-time a lctl)
  alt_s (tap-hold $tap-time $hold-time s lalt)
  met_d (tap-hold $tap-time $hold-time d lmet)
  sft_f (tap-hold $tap-time $hold-time f lsft)

  sft_j (tap-hold $tap-time $hold-time j rsft)
  met_k (tap-hold $tap-time $hold-time k rmet)
  alt_l (tap-hold $tap-time $hold-time l ralt)
  ctl_; (tap-hold $tap-time $hold-time ; rctl)

)

(deflayer base
  brdn  brup  _    _    _    _   prev  pp  next  mute  vold  volu
  tab     q        w        e        r     t   u      i        o        p
  @nav @ctl_a   @alt_s   @met_d   @sft_f   g   h   @sft_j   @met_k   @alt_l   @ctl_;   
  lsft    z        x        c        v     b   n      m        ,        .        /
)

(deflayer nav
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _  {      }    S-9   S-0 
  _ _ _ _ _ _ left  down   up   right  ;
  _ _ _ _ _ _ _       [     ]    S-,   S-. 
)
