[user]
  name = Jono Kumarich
  email = jonathankumarich@gmail.com
[credential]
		helper = osxkeychain
[init]
		defaultBranch = main
		templatedir = ~/.git-templates
[push]
		autoSetupRemote = true
[pull]
		rebase = true
[fetch]
		prune = true
[diff]
		colorMoved = default
[merge]
		conflictStyle = zdiff3
[core]
		editor = nvim
		excludesfile = ~/.config/git/.gitignore_global
		pager = delta
		whitespace = error
[interactive]
		diffFilter = delta --color-only
[delta]
		navigate = true
		line-numbers = true
		side-by-side = true

# https://www.benji.dog/articles/git-config/
# More specific patterns must come FIRST
# SSH remotes
[includeIf "hasconfig:remote.*.url:git@github.com:gotracksuit/**"]
	path = ~/.config/git/config-gh-tracksuit
[includeIf "hasconfig:remote.*.url:git@github.com:*/*"]
	path = ~/.config/git/config-gh-personal
# HTTPS remotes
[includeIf "hasconfig:remote.*.url:https://github.com/gotracksuit/**"]
	path = ~/.config/git/config-gh-tracksuit
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.config/git/config-gh-personal
