[user]
		name = jonathankumarich
		email = jonathankumarich@gmail.com
[credential]
		helper = osxkeychain
[init]
		defaultBranch = main
[push]
		autoSetupRemote = true
[pull]
		rebase = true
[fetch]
		prune = true
[diff]
		colorMoved = default
[merge]
		conflictStyle = zdiff3
[core]
		editor = nvim
		excludesfile = ~/.config/git/.gitignore_global
		hookspath = ~/.config/git/hooks
		pager = delta
[interactive]
		diffFilter = delta --color-only
[delta]
		navigate = true


# https://www.benji.dog/articles/git-config/
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
		path = ~/.config/git/config-github

[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
		path = ~/.config/git/config-gitlab

[includeIf "hasconfig:remote.*.url:git@bitbucket.org:*/**"]
		path = ~/.config/git/config-bitbucket
